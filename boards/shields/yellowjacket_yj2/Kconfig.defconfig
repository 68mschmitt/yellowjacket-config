# YJ2 is a wrapper shield: hardware comes from ../yellowjacket/yellowjacket.dtsi;
# this file only declares YJ2-specific shield symbols and keyboard names.

if SHIELD_YELLOWJACKET_YJ2_LEFT

config ZMK_KEYBOARD_NAME
	default "YJ2"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_YELLOWJACKET_YJ2_RIGHT

config ZMK_KEYBOARD_NAME
	default "YJ2_R"

endif

if SHIELD_YELLOWJACKET_YJ2_RIGHT || SHIELD_YELLOWJACKET_YJ2_LEFT

config ZMK_SPLIT
	default y


# Display/LVGL defaults are intentionally omitted. The current
# Yellowjacket hardware definitions do not enable a display node; keep
# display config with the variant that reintroduces active display support.

endif
