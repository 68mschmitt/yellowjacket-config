# Legacy direct shield symbols for the shared Yellowjacket hardware.
# The normal build matrix uses the YJ1/YJ2 wrapper shields in sibling
# directories, which provide their own names while reusing yellowjacket.dtsi.

if SHIELD_YELLOWJACKET_LEFT

config ZMK_KEYBOARD_NAME
	default "Yellow Jacket"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_YELLOWJACKET_RIGHT

config ZMK_KEYBOARD_NAME
	default "yellowjacket_R"

endif

if SHIELD_YELLOWJACKET_RIGHT || SHIELD_YELLOWJACKET_LEFT

config ZMK_SPLIT
	default y


# Display/LVGL defaults are intentionally omitted. The current
# Yellowjacket hardware definitions do not enable a display node; keep
# display config with the variant that reintroduces active display support.

endif
