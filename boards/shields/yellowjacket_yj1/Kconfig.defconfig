# YJ1 is a wrapper shield: hardware comes from ../yellowjacket/yellowjacket.dtsi;
# this file only declares YJ1-specific shield symbols and keyboard names.

if SHIELD_YELLOWJACKET_YJ1_LEFT

config ZMK_KEYBOARD_NAME
	default "YJ1"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_YELLOWJACKET_YJ1_RIGHT

config ZMK_KEYBOARD_NAME
	default "YJ1_R"

endif

if SHIELD_YELLOWJACKET_YJ1_RIGHT || SHIELD_YELLOWJACKET_YJ1_LEFT

config ZMK_SPLIT
	default y

endif
